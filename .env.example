# ═══════════════════════════════════════════════════════════
# 个人智能助手 · 环境变量模板
# 复制为 .env 并填入真实值，.env 已被 .gitignore 忽略，勿提交
# ═══════════════════════════════════════════════════════════

# ── 服务端 ──────────────────────────────────────────────
# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# LLM（OpenAI 兼容格式，DeepSeek 示例）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# Embedding（智谱 BigModel embedding-3 示例）
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=your-bigmodel-api-key
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=2048

# 数据库文件路径（默认 server/data/assistant.db）
DB_PATH=./data/assistant.db
# 小说项目文件根目录；项目文件只能写入此目录内
NOVEL_ROOT=./data/novels

# ── 周报推送 ────────────────────────────────────────────
# 每周几生成（0=周一 … 6=周日），几点
WEEKLY_REPORT_WEEKDAY=6
WEEKLY_REPORT_HOUR=21

# ── API 鉴权（安全必配！）────────────────────────────────
# 兼容旧客户端的主人/内部令牌（生产环境至少配置一个 32 字符随机值）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# 可按客户端角色拆分令牌；配置后服务端会按角色限制端点权限
OWNER_API_TOKEN=
INTERNAL_API_TOKEN=
COLLECTOR_API_TOKEN=
EXECUTOR_API_TOKEN=
QQ_API_TOKEN=

# ── 采集器（Windows 本地）───────────────────────────────
# 服务器地址（Tailscale 虚拟 IP 或域名）
SERVER_URL=http://100.x.y.z:8000
# 采集开关
# 行为采集默认关闭（仅心跳+执行器）；需要行为数据时改回 true
COLLECT_WINDOW=false
COLLECT_BROWSER=false
COLLECT_GIT=false
# 隐私过滤：事件上送前本地脱敏（密码/token/手机号/邮箱等）
PRIVACY_FILTER=true
# 监听的项目目录（git 扫描，逗号分隔）
GIT_REPOS=C:/Users/you/projects/repo1,C:/Users/you/projects/repo2

# ── 执行器（第 11 课：机器人操作 Windows 的白名单）────────
# list_dir/read_file 允许的根目录（逗号分隔，Windows 路径）；留空=禁止这两类操作
EXECUTOR_ALLOWED_ROOTS=C:/Users/you;F:/

# ── LLM 调优（可选，默认已够用）─────────────────────────
# 单次调用超时秒数 / 网络错误重试次数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── 记忆检索调优（可选）─────────────────────────────────
# 注入记忆条数 / 相似度门槛（0~1，越高越严格）/ importance 半衰期天数
INJECT_TOP_K=5
MIN_SIMILARITY=0.35
IMPORTANCE_DECAY_DAYS=30

# ── 多轮上下文（可选）───────────────────────────────────
# 携带最近 N 条原文，更早的用摘要续接
HISTORY_LIMIT=8

# ── 记忆整合与脱敏（可选）───────────────────────────────
# 摘要整合间隔（小时）/ 自定义敏感词（分号分隔，命中即脱敏）
CONSOLIDATION_INTERVAL_HOURS=4
SENSITIVE_TERMS=

# ── 采集器心跳（可选）───────────────────────────────────
# 超过该秒数无心跳视为电脑不在线（QQ 提示文案用）
HEARTBEAT_STALE_SECONDS=120

# ── QQ 推送（第 8 课：提醒唯一通道，仅服务器 .env 配置）──
# NapCat onebot HTTP 地址 + token + 主人 QQ 号（勿进仓库）
# 三项都配置后提醒才会推 QQ；QQ_ADMIN_ID 必须是纯数字
QQ_PUSH_URL=
QQ_PUSH_TOKEN=
QQ_ADMIN_ID=
