# ═══════════════════════════════════════════════════════════
# 个人智能助手 · 环境变量模板
# 复制为 .env 并填入真实值，.env 已被 .gitignore 忽略，勿提交
# ═══════════════════════════════════════════════════════════

# ── 服务端 ──────────────────────────────────────────────
# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# LLM（OpenAI 兼容格式，DeepSeek 示例）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# Embedding（硅基流动 Qwen3-Embedding-0.6B 示例）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024

# 数据库文件路径（默认 server/data/assistant.db）
DB_PATH=./data/assistant.db

# ── 周报推送 ────────────────────────────────────────────
# 每周几生成（0=周一 … 6=周日），几点
WEEKLY_REPORT_WEEKDAY=6
WEEKLY_REPORT_HOUR=21

# ── API 鉴权（安全必配！）────────────────────────────────
# 全端点统一令牌：Web 页面、采集器、桌面端都用它。
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-random-string

# ── 采集器（Windows 本地）───────────────────────────────
# 服务器地址（Tailscale 虚拟 IP 或域名）
SERVER_URL=http://100.x.y.z:8000
# 采集开关
COLLECT_WINDOW=true
COLLECT_BROWSER=true
COLLECT_GIT=true
# 隐私过滤：事件上送前本地脱敏（密码/token/手机号/邮箱等）
PRIVACY_FILTER=true
# 监听的项目目录（git 扫描，逗号分隔）
GIT_REPOS=C:/Users/you/projects/repo1,C:/Users/you/projects/repo2

# ── 语音 ────────────────────────────────────────────────
# 打开面板时语音播报问候（Windows SAPI 离线中文语音）
VOICE_GREETING=true
# AI 回复播报（默认关——回复太长念着烦；开启后每条回复都会朗读）
VOICE_REPLY=false
# 语音多样性：随机轮换系统已装语音（女声/男声），语速随机微调
VOICE_RANDOM=true
# 固定语音（留空=随机）：如 Microsoft Kangkang（男声）/ Microsoft Huihui（女声）
VOICE_NAME=
