# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 环境变量（含密钥，绝不入库）
# .env* 通配：原来只列了 .env / .env.local / .env.*.local，
# 手工备份出来的 .env.bak 不在其中——里面是同一份真实 API Key，
# 一次 git add -A 就会推上 GitHub。宁可多挡，不能漏。
.env
.env.*
!.env.example

# 数据文件（数据库/向量索引/日志）
# 注意 -shm/-wal：WAL 模式下的边文件不匹配 *.db，漏掉它们会把
# 几十 MB 的共享内存/预写日志推进仓库
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.hnsw
logs/
*.log

# 采集器断网缓存（个人行为数据，绝不入库）
collector/cache/

# 打包产物
dist/
build/
*.spec
*.exe

# 视觉预览产物
scripts/preview_out/

# 系统
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# AI 助手的工作目录（方案草稿/会话状态，不属于项目产物）
.narrafork/
